@using CCC.UI.ViewModels
@model SearchPetData
@{
	ViewData["Title"] = "Consolidated Report";
	Layout = "~/Views/Shared/_Layout.cshtml";

	SelectList lstMonth = ViewBag.lstMonth;
	SelectList lstYears = ViewBag.lstYears;
}

<link href="~/css/autocomplete.css" rel="stylesheet" />
@*<script src="https://code.jquery.com/ui/1.12.0/jquery-ui.min.js"></script>*@
<link href="~/lib/bootstrap-datepicker/css/bootstrap-datepicker.min.css" rel="stylesheet" />
<script src="~/lib/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
<script src="~/js/jquery.btnswitch.js"></script>
<link href="~/css/jquery.btnswitch.min.css" rel="stylesheet" />
<link href="~/css/jquery-ui.css" rel="stylesheet" />

<link href="~/lib/bootstrap-multiselect/bootstrap-multiselect.css" rel="stylesheet" />
<script src="~/lib/bootstrap-multiselect/bootstrap-multiselect.js"></script>



<div class="mainContent">
	<div class="conHeader">
		<div class="row">
			<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
				<div class="pull-left">
					<ol class="breadcrumb">
						<li class="breadcrumb-item active" aria-current="page">Consolidated Reports</li>
					</ol>
				</div>
			</div>
		</div>
	</div>
	<div class="conInner">
		<div class="conInner">
			<div class="mobileFilter">
				<div class="hideShowfilter">
					<div class="filterData mobilecofilters centerReportPage">
						<div class="formGroupTop pos mobile4Lis" id="pnlSearch">
							<div class="row">
								<div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
									<div class="form-group">
										<label>From Month</label>
										<select asp-for="Month" asp-items="lstMonth" id="ddlFromMonth" class="form-control">
										</select>
										<span id="spMonth" class="redColor"></span>
									</div>
								</div>
							
								<div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
									<div class="form-group">
										<label>From Year</label>
										<select asp-for="Year" asp-items="lstYears" id="ddlFromYear" class="form-control">
										</select>
										<span id="spYear" class="redColor"></span>
									</div>
								</div>
								<div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
									<div class="form-group">
										<label>To Month</label>
										<select asp-for="Month" asp-items="lstMonth" id="ddlToMonth" class="form-control">
										</select>
										<span id="spMonth" class="redColor"></span>
									</div>
								</div>
								<div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
									<div class="form-group">
										<label>To Year</label>
										<select asp-for="Year" asp-items="lstYears" id="ddlToYear" class="form-control">
										</select>
										<span id="spYear" class="redColor"></span>
									</div>
								</div>
								<div class="">
									<div class="form-group">
										<div class="row"></div><br />
										<div class="row">
											<div class="userBoxFooter">
												<div class="pull-right">
													<div class="form-group"></div>
													<button type="button" class="btn btn-primary btn-search " style="margin-left:30px;" id="btnExportExcel">
														<svg width="14" height="14" fill="none" viewBox="0 0 14 14">
															<path stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.375" d="M13 9v2.667A1.334 1.334 0 0 1 11.667 13H2.333A1.334 1.334 0 0 1 1 11.667V9m2.667-3.333L7 9m0 0 3.333-3.333M7 9V1"></path>
														</svg>Export Excel
													</button>
												</div>
											</div>
										</div>

									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	$("#btnExportExcel").on('click', function () {
		var searchObj = new Object();
		var frmMonth = $('#ddlFromMonth').val();
		var frmYear = $('#ddlFromYear').val();
		var toMonth = $('#ddlToMonth').val();
		var toYear= $('#ddlToYear').val();

		var url = '@Url.Action("ExportConsolidatedReport", "Report")?&frmMonth=' + frmMonth  + '&fromYear=' + frmYear +'&toMonth=' +toMonth + '&toYear='+toYear;
		document.location.href = url;

